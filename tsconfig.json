{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmitOnError": true,
		"stripInternal": true
	},
	"include": ["src"],
	"exclude": ["dist", "**/*.test.ts"]
}
